---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% comment %} insight:true のみ。デフォルト noindex の記事は載せない。 {% endcomment %}
  {% assign reviewed_insights = site.tbnews | where: 'insight', true | sort: 'date' | reverse %}
  {% for post in reviewed_insights %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
    <lastmod>{% if post.last_modified %}{{ post.last_modified | date: "%Y-%m-%d" }}T00:00:00+09:00{% else %}{{ post.date | date_to_xmlschema }}{% endif %}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  {% endfor %}
</urlset>
