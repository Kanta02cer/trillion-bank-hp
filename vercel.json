{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "jekyll",
  "installCommand": "bundle install",
  "buildCommand": "bash scripts/jekyll_build.sh",
  "outputDirectory": "_site",
  "git": {
    "deploymentEnabled": {
      "main": false,
      "vercel-deploy": true
    }
  },
  "cleanUrls": true,
  "trailingSlash": true
}
