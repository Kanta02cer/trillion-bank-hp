---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:news="http://www.google.com/schemas/sitemap-news/0.9">
  {% assign reviewed_insights = site.tbnews | where: 'insight', true | sort: 'date' | reverse %}
  {% for post in reviewed_insights %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
    <news:news>
      <news:publication>
        <news:name>株式会社Trillion Bank</news:name>
        <news:language>ja</news:language>
      </news:publication>
      <news:publication_date>{{ post.date | date_to_xmlschema }}</news:publication_date>
      <news:title>{{ post.title | xml_escape }}</news:title>
    </news:news>
  </url>
  {% endfor %}
</urlset>
